{
  "id": "researcher",
  "label": "Kutató",
  "description": "Piackutatás, versenytárs-elemzés, webes források olvasása. Prompt injection szempontból ugyanúgy kiemelt mint a marketinges. Draft-only: riportot ír a mappájába, nem küld magától kifelé.",
  "permissionMode": "strict",
  "filesystem": {
    "allow": [
      "Read(${AGENT_DIR}/**)",
      "Write(${AGENT_DIR}/**)",
      "Edit(${AGENT_DIR}/**)",
      "Read(${HOME}/Downloads/**)",
      "Bash(ls:*)",
      "Bash(${INSTALL_DIR}/scripts/agent-wrappers/check-allowlist.sh:*)",
      "Bash(${INSTALL_DIR}/scripts/agent-wrappers/memo.sh:*)",
      "Bash(${INSTALL_DIR}/scripts/agent-wrappers/msg-wolfe.sh:*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__plugin_telegram_telegram__reply"
    ],
    "deny": [
      "Read(${HOME}/.ssh/**)",
      "Read(${HOME}/.aws/**)",
      "Read(${HOME}/.gnupg/**)",
      "Read(${HOME}/.env)",
      "Read(**/.env)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -d:*)",
      "Bash(curl --data:*)",
      "Bash(wget:*)",
      "Bash(git push:*)"
    ]
  }
}
